function alcotesterCheckAlcohol(type) {
    drunk = 0;
    if (type <= -50000 || type > -50000 && type <= -30000) { drunk = '0.000' } else if (type > -30000 && type <= -20000) { drunk = alcotesterGetRandom(0.0, 0.140) } else if (type > -20000 && type <= 0) { drunk = alcotesterGetRandom(0.175, 0.220) } else if (type > 0 && type <= 15000) { drunk = alcotesterGetRandom(0.220, 0.850) } else if (type > 15000 && type <= 50000) { drunk = alcotesterGetRandom(0.900, 1.300) } else if (type > 50000 && type <= 150000) { drunk = alcotesterGetRandom(1.400, 2.200) } else if (type > 15000) { drunk = '>2.500' }
    return drunk;
}

function alcotesterGetRandom(min, max) {
    return (Math.random() * (max - min) + min).toFixed(3);
}

function getAlcoholLevel(intoxication) {
    const points = [
        { level: 0, value: 0.000 },
        { level: 10, value: 0.160 },
        { level: 30, value: 0.250 },
        { level: 50, value: 1.200 },
        { level: 100, value: 2.700 }
    ];

    for (let i = 0; i < points.length - 1; i++) {
        const p1 = points[i];
        const p2 = points[i + 1];

        if (intoxication >= p1.level && intoxication <= p2.level) {
            const ratio = (intoxication - p1.level) / (p2.level - p1.level);
            return (p1.value + ratio * (p2.value - p1.value)).toFixed(3);
        }
    }

    return intoxication >= 100 ? ">2.500" : "0.000";
}


