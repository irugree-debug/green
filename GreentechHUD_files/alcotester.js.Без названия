document.addEventListener('click', function(event) {
    if (event.target.classList[0] == 'alcotester-screen' || event.target.parentNode.classList[0] == 'alcotester-screen' || event.target.parentNode.parentNode.classList[0] == 'alcotester-screen' || event.target.parentNode.parentNode.parentNode.classList[0] == 'alcotester-screen' || event.target.parentNode.parentNode.parentNode.parentNode.classList[0] == 'alcotester-screen' || event.target.classList[0] == 'alcotester-screen-main-fulldata-keyboard-button' && alcotesterOn) {
        cefSoundPlay('alcotesterpick.wav');
    }

    if (event.target.classList[0] == 'alcotester-screen-main-fulldata-keyboard-button') {
        if (event.target.textContent == 'ПРОБЕЛ' || event.target.textContent == 'SPACE') {
            document.querySelector('.alcotester-screen-main-fulldata-input').value = document.querySelector('.alcotester-screen-main-fulldata-input').value + ' ';
