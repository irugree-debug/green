        document.querySelector('.alcotester-screen-main-fullresult-text2').setAttribute('id', 'prervan');
        type = 'fullresult';
    } else if (type == 'fullresult-otkaz') {
        alcotesterAME('ознакомился с результатами полного продувания.');
