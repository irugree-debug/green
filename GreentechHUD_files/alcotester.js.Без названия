function alcotesterStartVidoh() {
    if (alcotesterType == 'scrining') {
        alcotestervidoh.play();
        alcotesterVidohNow = true;
        alcotestProgress = 100;
        document.querySelector('.alcotester-vidoh-button-span').style.transition = '2000'.replace('000', '') + 's linear';
        document.querySelector('.alcotester-screen-main-progress-text').textContent = '100%';
        document.querySelector('.alcotester-screen-main-progress-span').style.width = '100%';
        document.querySelector('.alcotester-vidoh-button-span').style.height = '100%';
        alcotestPressedProgress = setInterval(() => {
            if (alcotestProgress == 100) { alcotestProgress = 75; } else if (alcotestProgress == 75) { alcotestProgress = 50; } else if (alcotestProgress == 50) { alcotestProgress = 25; } else if (alcotestProgress == 25) { alcotestProgress = 0; }
            document.querySelector('.alcotester-screen-main-progress-text').textContent = alcotestProgress + '%';
            document.querySelector('.alcotester-screen-main-progress-span').style.width = alcotestProgress + '%';
        }, 2000 / 4);

        alcotestPressedTimeout = setTimeout(() => {
            if (alcotesterVidohNow) {
                alcotesterVidohNow = false;
                clearInterval(alcotestPressedProgress);
                setTimeout(() => {
                    cefSoundPlay('alcotestershelc.wav');
                }, 300);
                if (alcotesterIsInspector) {
                    setTimeout(() => {
                        alcotesterSetResponse(true, 'setDrunk;-10000') //test
                        uCefJS.triggerEvent('alcotester:getDrunk', 1);
                    }, 700);
                }
            }
        }, 2000);
    } else if (alcotesterType == 'fullscrining') {
        alcotestervidoh2.play();
        alcotesterVidohNow = true;
        alcotestProgress = 100;
        document.querySelector('.alcotester-vidoh-button-span').style.transition = '5000'.replace('000', '') + 's linear';
        document.querySelector('.alcotester-screen-main-progress-text').textContent = '100%';
        document.querySelector('.alcotester-screen-main-progress-span').style.width = '100%';
        document.querySelector('.alcotester-vidoh-button-span').style.height = '100%';
        alcotestPressedProgress = setInterval(() => {
            if (alcotestProgress == 100) { alcotestProgress = 75; } else if (alcotestProgress == 75) { alcotestProgress = 50; } else if (alcotestProgress == 50) { alcotestProgress = 25; } else if (alcotestProgress == 25) { alcotestProgress = 0; }
            document.querySelector('.alcotester-screen-main-progress-text').textContent = alcotestProgress + '%';
            document.querySelector('.alcotester-screen-main-progress-span').style.width = alcotestProgress + '%';
        }, 5000 / 4);

        alcotestPressedTimeout = setTimeout(() => {
            if (alcotesterVidohNow) {
                alcotesterVidohNow = false;
                alcotesterStopVidoh();
                clearInterval(alcotestPressedProgress);
                setTimeout(() => {
                    cefSoundPlay('alcotestershelc.wav');
                }, 300);
                if (alcotesterIsInspector) {
                    setTimeout(() => {
                        alcotesterSetPage('analiz');
                        setTimeout(() => {
                            alcotesterSetResponse(true, 'setDrunk;20000') //test
                            uCefJS.triggerEvent('alcotester:getDrunk', 1);
                        }, 3500);
                    }, 700);
                }
            }
        }, 5000);
    }
}

function alcotesterStopVidoh() {
    clearInterval(alcotestPressedProgress);
    document.querySelector('.alcotester-vidoh-button-span').style.transition = '0s';
    document.querySelector('.alcotester-vidoh-button-span').style.height = '0%';

    if (alcotesterType == 'scrining') {
        alcotestervidoh.pause();
        alcotestervidoh.currentTime = 0;
        alcotesterVidohNow = false;
    } else if (alcotesterType == 'fullscrining') {
        alcotestervidoh2.pause();
        alcotestervidoh2.currentTime = 0;
        if (alcotesterVidohNow) {
            alcotesterVidohNow = false;
            clearTimeout(checkOtkaz);
            setTimeout(() => {
                cefSoundPlay('alcotestershelc.wav');
                setTimeout(() => {
                    alcotesterSetPage('prervan');
                }, 200);
            }, 300);
        }
    }
}

