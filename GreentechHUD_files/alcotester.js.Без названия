        } else {
            uCefJS.triggerEvent('alcotester:Response', 'show;' + alcotesterPage);
        }
    }
}

function alcotesterSetResponse(isInspector, type) {
    if (type.split(';')[0] == 'show') {
        showAlcotester(isInspector);
        alcotesterOn = true;
        if (type.split(';')[1] == 'scriningresult' || type.split(';')[1] == 'fullresult') {
            alcotesterAlcohol = type.split(';')[2];
        }
        alcotesterSetPage(type.split(';')[1]);
    } else if (type.split(';')[0] == 'startVidoh') {
        alcotesterStartVidoh();
    } else if (type.split(';')[0] == 'stopVidoh') {
        alcotesterStopVidoh();
    } else if (type.split(';')[0] == 'setDrunk') {
        alcotesterAlcohol = alcotesterCheckAlcohol(type.split(';')[1]);
        setTimeout(() => {
            if (alcotesterType == 'scrining') {
                alcotesterSetPage('scriningresult');
            } else if (alcotesterType == 'fullscrining') {
                alcotesterSetPage('fullresult');
            }
        }, 2000);
    } else if (type.split(';')[0] == 'getPage') {
        if (alcotesterIsInspector) {
            if (alcotesterPage == 'scriningresult') {
                uCefJS.triggerEvent('alcotester:Response', 'show;' + alcotesterPage + ';' + alcotesterAlcohol);
            } else {
                uCefJS.triggerEvent('alcotester:Response', 'show;' + alcotesterPage);
            }
        }
    }
}

