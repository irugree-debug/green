function alcotesterHideCheck(type) {
    document.querySelector('.protokol-menu').style.display = 'none';
    document.querySelector('.protokol-menu-' + type).style.display = 'none';
    document.querySelector('.alcotester-check').style.display = 'none';
    document.querySelector('#alcotester-check-img1').style.display = 'none';
    document.querySelector('#alcotester-check-img2').style.display = 'none';
    document.querySelector('#canvas').style.display = 'none';
    podpisDraw = false;
    uCefJS.triggerEvent('Send:AME', 'отложил чек освидетельствования.');
}

function alcotesterCheckGet(type) {
    if (type == 0 || type == 1) {
        if (isCanvasBlank(document.getElementById('canvas'))) {
            uCefJS.triggerEvent('FIS:Getprotokol', 6);
            return
        }
        try {
            var img = document.getElementById('canvas').toDataURL('image/png', 1).split(',')[1];
        } catch (e) {
            var img = document.getElementById('canvas').toDataURL().split(',')[1];
        }
        $.ajax({
            url: 'https://api.imgur.com/3/image',
            type: 'post',
            headers: {
                Authorization: 'Client-ID f9715a00108c0b3'
            },
            data: {
                image: img
            },
            dataType: 'json',
            success: function(response) {
                if (type == 0) {
                    if (response.success) {
                        podpisIMG1 = response.data.link;
                        elementCheck = '';
                        document.querySelectorAll('.alcotester-check-text .alcotester-full span').forEach(element => {
                            elementCheck += element.textContent + ';';
                        });
                        uCefJS.triggerEvent('alcotester:GetCheck', 1, response.data.link, elementCheck);
                        alcotesterHideCheck(10);
                        uCefJS.triggerEvent('Send:AME', 'подписал чек освидетельствования, передал его вместе с ручкой.');
                        // setTimeout(() => {
                        //     alcotesterShowCheck(1, response.data.link, elementCheck)
                        // }, 2000);
                    }
                } else if (type == 1) {
                    if (response.success) {
                        podpisIMG2 = response.data.link;
                        uCefJS.triggerEvent('alcotester:GetCheck', 2, response.data.link);
                        alcotesterHideCheck(11);
                        uCefJS.triggerEvent('Send:AME', 'подписал чек освидетельствования, вернул его обратно сотруднику вместе с ручкой.');
                        // setTimeout(() => {
                        //     alcotesterShowCheck(2, response.data.link)
                        // }, 2000);
                    }
                }
            }
        });
    }
}

function alcotesterAME(text) {
    if (alcotesterIsInspector) {
        uCefJS.triggerEvent('Send:AME', text);
    }
}