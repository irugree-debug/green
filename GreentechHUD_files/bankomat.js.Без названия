function bankomatResponse(type, subtype, value, value2, value3) {
    if (type == 'success') {
        if (subtype == 'putCash') {
            bankomatSetPage('success', 'Счет пополнен', value+' ₽');
        }
        else if (subtype == 'mobile') {
            bankomatSetPage('success', 'Счет телефона пополнен', value+' ₽');
        }
        else if (subtype == 'getCash') {
            bankomatSetPage('success', 'Наличные выданы', value+' ₽');
        }
        else if (subtype == 'nalog') {
            if (bankomatLastNalog[0] == 'ipoteka') {
                bankomatSetPage('success', 'Сумма внесена', value+' ₽');
            }
            else {
                bankomatSetPage('success', 'Налог оплачен', value+' дней');
            }
        }
        else if (subtype == 'ticket') {
            bankomatSetPage('success', 'Штраф оплачен');
        }

    }
    else if (type == 'fail') {
        bankomatSetPage('fail', value);
    }
    else if (type == 'nalogi') {
        bankomatSetPage('nalogiChoose-'+subtype, value, value2, value3);
    }
    else if (type == 'nalogiChoose') {
        bankomatSetPage('nalogiButtons', value, value2);
    }
    else if (type == 'ticket') {
        ticketHTML = `<tr>
            <td><input type="checkbox" name="bankomatTickets" id="bankomatTickets" onclick="bankomatTicketCheck(this)"></td>
            <td>`+subtype.split('/')[0]+`</td>
            <td>`+subtype.split('/')[1]+`</td>
            <td>`+subtype.split('/')[2]+`</td>
            <td>`+subtype.split('/')[3]+`</td>
            <td>`+subtype.split('/')[4]+`</td>
        </tr>`
        document.querySelector('.bankomat-page-tickets-table tbody').insertAdjacentHTML('beforeend', ticketHTML);
        bankomatSetPage('tickets');
    }
    else if (type == 'newCard') {
        bankomatSetPage('newCard', subtype, value);
    }
    else if (type == 'ipoteka') {
        document.querySelector('#ipoteka-choose-type').textContent = subtype.split('/')[0];
        document.querySelector('#ipoteka-choose-id').textContent = '№'+subtype.split('/')[1];
        document.querySelector('#ipoteka-choose-price').textContent = moneyFormat(Number(subtype.split('/')[2]))+' ₽';
        document.querySelector('#ipoteka-choose-12 .bankomat-page-ipoteka-choose-block-amount').textContent = moneyFormat(Number(value.split('/')[0]))+' ₽';
        document.querySelector('#ipoteka-choose-12 .bankomat-page-ipoteka-choose-block-summa-block-summa').textContent = moneyFormat(Number(value.split('/')[1]))+' ₽';
        document.querySelector('#ipoteka-choose-6 .bankomat-page-ipoteka-choose-block-amount').textContent = moneyFormat(Number(value2.split('/')[0]))+' ₽';
        document.querySelector('#ipoteka-choose-6 .bankomat-page-ipoteka-choose-block-summa-block-summa').textContent = moneyFormat(Number(value2.split('/')[1]))+' ₽';
        document.querySelector('#ipoteka-choose-3 .bankomat-page-ipoteka-choose-block-amount').textContent = moneyFormat(Number(value3.split('/')[0]))+' ₽';
        document.querySelector('#ipoteka-choose-3 .bankomat-page-ipoteka-choose-block-summa-block-summa').textContent = moneyFormat(Number(value3.split('/')[1]))+' ₽';
        document.querySelectorAll('.bankomat-page-ipoteka-choose-block').forEach(element => {
            element.classList.remove('active');
        });
        document.querySelector('.bankomat-page-ipoteka-choose-button').classList.add('disable');
        bankomatSetPage('ipoteka-choose');
    }
    else if (type == 'ipotekaChoose') {
        switch (subtype.split('/')[1]) {
            case 'Дом в деревне': document.querySelector('#ipoteka-success-type').textContent = 'Номер дома';
            case 'Квартира': document.querySelector('#ipoteka-success-type').textContent = 'Номер квартиры';
            case 'Элитная Квартира': document.querySelector('#ipoteka-success-type').textContent = 'Номер квартиры';
        }
        document.querySelector('#ipoteka-success-id').textContent = '#'+subtype.split('/')[0];
        document.querySelector('#ipoteka-success-type2').textContent = subtype.split('/')[1];
        document.querySelector('#ipoteka-success-date').textContent = subtype.split('/')[2];
        document.querySelector('#ipoteka-success-amount').textContent = subtype.split('/')[3];
        document.querySelector('#ipoteka-success-summa').textContent = subtype.split('/')[4]+' ₽';
        bankomatSetPage('ipoteka-success');
    }
}

