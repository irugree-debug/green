document.addEventListener('keydown', function(event) {
    if (document.querySelector('.bankomat-page#pincode').style.display != 'none') {
        if (pinCodeInts.indexOf(Number(event.key)) != -1) {
            pinCodeWrite += event.key;
            for (i = 1; i <= pinCodeWrite.split('').length; i++) {
                document.querySelector('.bankomat-page-pincode-circle[pincodenum="'+i+'"]').classList.add('active');
                if (i == 4) {
                    setTimeout(() => {
                        document.querySelector('.bankomat-page-pincode-fail').style.display = 'none';
                        document.querySelectorAll('.bankomat-page-pincode-circle').forEach(element => {
                            element.classList.remove('active');
                        });
                        if (pinCodeWrite == pinCode) {
                            if (bankomatType == 0) {
                                bankomatPage = 'bankomat-main';
                                bankomatSetPage('bankomat-main');
                            }
                            else if (bankomatType == 1) {
                                bankomatPage = 'terminal-main';
                                bankomatSetPage('terminal-main');
                            }
                        }
                        else {
                            document.querySelector('.bankomat-page-pincode-fail').style.display = 'block';
                        }
                        pinCodeWrite = '';
                    }, 200);
                }
            }
        }
    }
    else if (document.querySelector('.bankomat-page#buttons').style.display != 'none') {
        if (pinCodeInts.indexOf(Number(event.key)) != -1) {
            bankomatButtonsClick(event.key);
        }
        else if (event.key == 'Backspace') {
            bankomatButtonsClick('del');
        }
    }
});

function showBankomat(type, nickname, pincode, numberCard, phoneBalance) {
    pinCode = pincode;
    bankomatType = type;
    bankomatBalanceMobile = phoneBalance;
    document.querySelectorAll('.bankomat-page-main-img-nickname').forEach(element => {
        element.textContent = nickname
    });
    if (numberCard == 'None') {
        numberCard = '0000 0000 0000 0000';
    }
    document.querySelectorAll('.bankomat-page-main-img-number').forEach(element => {
        element.textContent = numberCard;
    });
    document.querySelector('.bankomat').style.display = '';
    if (type == 0 || type == 1) {
        bankomatPage = 'pincode';
        bankomatSetPage('pincode');
    }
    else if (type == 2) {
        bankomatPage = 'bank-main';
        bankomatSetPage('bank-main');
    }
    switch (type) {
        case 0: document.querySelector('.bankomat-esc-text').innerHTML = 'Закрыть<br>банкомат'; break;
        case 1: document.querySelector('.bankomat-esc-text').innerHTML = 'Закрыть<br>терминал'; break;
        case 2: document.querySelector('.bankomat-esc-text').innerHTML = 'Закрыть<br>банк'; break;
    }
}

function hideBankomat() {
    document.querySelector('.bankomat').style.display = 'none';
}

function deleteNalogi() {
    document.querySelectorAll('.bankomat-page-nalogi-choose-block').forEach(element => {
