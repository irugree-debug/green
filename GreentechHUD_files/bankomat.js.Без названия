function bankomatShowBalance() {
    switch (bankomatType) {
        case 0: docBalance = '#bankomat-balance'; break;
        case 1: docBalance = '#terminal-balance'; break;
        case 2: docBalance = '#bank-balance'; break;
    }
    if (document.querySelector(docBalance).getAttribute('isshow') == 'false') {
        document.querySelector(docBalance).setAttribute('isshow', 'true');
        document.querySelector(docBalance).textContent = moneyFormat2(document.querySelector('#text_card').textContent.replace(' ₽', '').replaceAll('.', ''))+' ₽';
    }
    else if (document.querySelector(docBalance).getAttribute('isshow') == 'true') {
        document.querySelector(docBalance).setAttribute('isshow', 'false');
        document.querySelector(docBalance).textContent = '* *** *** ₽';
    }
}

function bankomatButtonsClick(type) {
    if (type != 'del' && document.querySelector('.bankomat-page-buttons-input span').textContent.length <= 9) {
        if (type == 0 && document.querySelector('.bankomat-page-buttons-input span').textContent.length == 0) return;
        document.querySelector('.bankomat-page-buttons-input span').textContent += type;
    }
    else if (type == 'del' && document.querySelector('.bankomat-page-buttons-input span').textContent) {
        document.querySelector('.bankomat-page-buttons-input span').textContent = document.querySelector('.bankomat-page-buttons-input span').textContent.slice(0, -1);
    }
}

function bankomatDeleteTickets() {
    document.querySelectorAll('.bankomat-page-tickets-table tbody tr').forEach(element => {
        element.remove();
    });
    document.querySelector('input[name="bankomatTicketsAll"]').checked = false;
}

function bankomatTicketsAll() {
    if (document.querySelector('input[name="bankomatTicketsAll"]').checked) {
        document.querySelectorAll('#bankomatTickets').forEach(element => {
            element.checked = true;
        });
    }
    else {
        document.querySelectorAll('#bankomatTickets').forEach(element => {
            element.checked = false;
        });
    }

    isTickets = false;
    document.querySelectorAll('#bankomatTickets').forEach(element => {
        if (element.checked) {
            isTickets = true;
            document.querySelector('.bankomat-page-tickets-button-oplata').classList.remove('disable');
        }
    });
    if (!isTickets) {
        document.querySelector('.bankomat-page-tickets-button-oplata').classList.add('disable');
    }
}

function bankomatTicketCheck(element) {
    isTickets = false;
    isTicketsAll = true;
    document.querySelectorAll('#bankomatTickets').forEach(element => {
        if (element.getAttribute('name') != 'bankomatTicketsAll') {
            if (element.checked) {
                isTickets = true;
                document.querySelector('.bankomat-page-tickets-button-oplata').classList.remove('disable');
            }
            else {
                isTicketsAll = false;
            }
        }
    });

    if (!isTickets) {
        document.querySelector('.bankomat-page-tickets-button-oplata').classList.add('disable');
    }
    
    if (isTicketsAll) {
        document.querySelector('input[name="bankomatTicketsAll"]').checked = true;
    }
    else {
        document.querySelector('input[name="bankomatTicketsAll"]').checked = false;
    }
}

function bankomatTicketPay() {
    document.querySelectorAll('input[name="bankomatTickets"]').forEach(element => {
        if (element.checked) {
            console.log('bankomat:ticket', Number(element.parentElement.parentElement.querySelectorAll('td')[1].textContent));
            uCefJS.triggerEvent('bankomat:ticket', Number(element.parentElement.parentElement.querySelectorAll('td')[1].textContent));
            // bankomatResponse('success', 'ticket'); //test
        }
    });
}