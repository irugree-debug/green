function casinoDiceCheckWinner() {
    casinoDiceOwnScore = Number(document.querySelector('.casino-window-body-dice-poly.own .casino-window-body-dice-poly-score span').textContent);
    casinoDiceVsScore = Number(document.querySelector('.casino-window-body-dice-poly.vs .casino-window-body-dice-poly-score span').textContent);
    casinoDiceVsNickname = document.querySelector('.casino-window-body-dice-poly.vs .casino-window-body-dice-poly-nickname').textContent;

    if (casinoDiceOwnScore > casinoDiceVsScore) {
        casinoShowDialog('info', 'Вы выиграли, набрав большее количество очков: '+casinoDiceOwnScore+'.', 'Хорошо');
        uCefJS.triggerEvent('casino:giveMoney', casinoNickname, (casinoLastBet*2)*0.9);
        uCefJS.triggerEvent('casino:Response', 'dice', 'showDialog/info/'+casinoNickname+' выигрывает, набрав большее количество очков: '+casinoDiceOwnScore+'./Хорошо');
    }
    else if (casinoDiceOwnScore < casinoDiceVsScore) {
        casinoShowDialog('info', casinoDiceVsNickname+' выигрывает, набрав большее количество очков: '+casinoDiceVsScore+'.', 'Хорошо');
        uCefJS.triggerEvent('casino:giveMoney', casinoDiceVsNickname, (casinoLastBet*2)*0.9);
        uCefJS.triggerEvent('casino:Response', 'dice', 'showDialog/info/Вы выиграли, набрав большее количество очков: '+casinoDiceVsScore+'./Хорошо');
    }
    else if (casinoDiceOwnScore == casinoDiceVsScore) {
        casinoShowDialog('info', 'Ничья! Вы набрали одинаковое количество очков.', 'Хорошо');
        uCefJS.triggerEvent('casino:giveMoney', casinoNickname, casinoLastBet*0.9);
        uCefJS.triggerEvent('casino:giveMoney', casinoDiceVsNickname, casinoLastBet*0.9);
        uCefJS.triggerEvent('casino:Response', 'dice', 'showDialog/info/Ничья! Вы набрали одинаковое количество очков./Хорошо');
    }

    casinoLastBet = 0;
    casinoIsGame = false;

    setTimeout(() => {
        casinoDiceStopGame();
        uCefJS.triggerEvent('casino:Response', 'dice', 'stopGame');
    }, 2000);
}

