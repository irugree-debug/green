function casinoResponse(type, response, response2) {
    switch (type) {
        case 'dice':
            if (response.split('/')[0] == 'join') {
                document.querySelector('.casino-window-body-dice-poly.vs .casino-window-body-dice-poly-nickname').textContent = response.split('/')[1];
            }
            else if (response.split('/')[0] == 'bet') {
                if (Number(document.querySelector('.casino-window-body-money-text span').textContent.replaceAll('.', '')) < Number(response.split('/')[2])) {
                    uCefJS.triggerEvent('casino:Response', 'dice', 'noMoneyBet');
                    return;
                }
                casinoShowDialog('askToPlay', response.split('/')[1], response.split('/')[2]);
                casinoLastBet = Number(response.split('/')[2]);
            }
            else if (response.split('/')[0] == 'noMoneyBet') {
                casinoLastBet = 0;
                casinoHideDialog();
                setTimeout(() => {
                    casinoShowDialog('info', 'У игрока недостаточно денег.', 'Хорошо');
                }, 300);
            }
            else if (response.split('/')[0] == 'noResponseBet') {
                setTimeout(() => {
                    casinoShowDialog('info', 'Игрок не ответил на ставку и был исключен из игры.', 'Хорошо');
                }, 300);
            }
            else if (response.split('/')[0] == 'cancelBet') {
                clearInterval(casinoBetInterval);
                casinoHideDialog();
                setTimeout(() => {
                    casinoShowDialog('info', 'Игрок отказался от вашей ставки.', 'Хорошо');
                }, 300);
            }
            else if (response.split('/')[0] == 'agreeBet') {
                uCefJS.triggerEvent('casino:removeMoney', casinoLastBet);
                clearInterval(casinoBetInterval);
                casinoHideDialog();
                casinoDiceStart(true);
            }
            else if (response.split('/')[0] == 'exit') {
                if (casinoIsGame) {
                    uCefJS.triggerEvent('casino:giveMoney', casinoNickname, casinoLastBet);
                    casinoShowDialog('info', 'Игрок покинул игру, деньги возвращены.', 'Хорошо');
                }
                showCasino('dice', casinoNickname);
            }
            else if (response.split('/')[0] == 'update') {
                casinoDiceUpdate(response.split('/')[1], response.split('/')[2], response.split('/')[3]);
            }
            else if (response.split('/')[0] == 'starterStop') {
                casinoDiceNonStarterStart();
            }
            else if (response.split('/')[0] == 'nonStarterStop') {
                setTimeout(() => {
                    casinoDiceCheckWinner();
                }, 2000);
            }
            else if (response.split('/')[0] == 'stopGame') {
                casinoDiceStopGame();
            }
            else if (response.split('/')[0] == 'showDialog') {
                casinoShowDialog(response.split('/')[1], response.split('/')[2], response.split('/')[3]);
            }
            break;
        case 'role':
            if (response.split('/')[0] == 'join') {
                isJoin = false;
                document.querySelectorAll('[casinoroleplayer] .casino-window-body-role-bottom-player-nickname').forEach(element => {
                    if (element.style.visibility == 'hidden' && !isJoin) {
                        element.textContent = response.split('/')[1];
                        element.style.visibility = 'visible';
                        isJoin = true;
                    }
                });
            }
            else if (response.split('/')[0] == 'exit') {
                document.querySelectorAll('[casinoroleplayer]').forEach(element => {
                    if (element.querySelector('.casino-window-body-role-bottom-player-nickname').textContent == response.split('/')[1]) {
                        element.querySelector('.casino-window-body-role-bottom-player-nickname').style.visibility = 'hidden';
                        element.querySelector('.casino-window-body-role-bottom-player-bottom').style.visibility = 'hidden';
                    }
                });
            }
            else if (response.split('/')[0] == 'bet') {
                document.querySelectorAll('[casinoroleplayer]').forEach(element => {
                    if (element.querySelector('.casino-window-body-role-bottom-player-nickname').textContent == response.split('/')[1]) {
                        stavka = response.split('/')[2];
                        if (stavka == 'chet') {
                            stavka = 'ЧЕТ';
                        }
                        else if (stavka == 'nechet') {
                            stavka = 'НЕЧЕТ';
                        }
                        else if (stavka == 'red') {
                            stavka = 'КРАСН';
                        }
                        else if (stavka == 'black') {
                            stavka = 'ЧЕРН';
                        }
                        element.querySelector('.casino-window-body-role-bottom-player-bottom-stavka').textContent = stavka;
                        element.querySelector('.casino-window-body-role-bottom-player-bottom-summa').textContent = moneyFormat(Number(response.split('/')[3]))+' ₽';
                        element.querySelector('.casino-window-body-role-bottom-player-bottom').style.visibility = 'visible';
                    }
                });
            }
            else if (response.split('/')[0] == 'startTime') {
                document.querySelector('.casino-window-body-page-role-start-time span').textContent = '15';
                document.querySelector('.casino-window-body-page-role-start-time').style.visibility = 'visible';
                casinoRoleStartTime = setInterval(() => {
                    document.querySelector('.casino-window-body-page-role-start-time span').textContent = Number(document.querySelector('.casino-window-body-page-role-start-time span').textContent)-1;

                    if (document.querySelector('.casino-window-body-page-role-start-time span').textContent == '0') {
                        clearInterval(casinoRoleStartTime);
                        document.querySelector('.casino-window-body-page-role-start-time').style.visibility = 'hidden';
                        
                        if (casinoRoleLastBet) {
                            casinoResponse('role', 'start/'+casinoRoleOneSector*Number(response.split('/')[1])+'/'+casinoRoleOneSector*Number(response.split('/')[2])); //TEST
                        }
                        else {
                            uCefJS.triggerEvent("Casino:Close", 1);
                            casinoHideDialog();
                            showNotice(4, 'Казино', 'Вы не поставили ставку и были исключены из игры.');
                        }

                        // casinoResponse('role', 'start/'+casinoRandom(casinoRoleOneSector*200, casinoRoleOneSector*400)+'/'+casinoRandom(casinoRoleOneSector*200, casinoRoleOneSector*400)); //TEST
                        // casinoResponse('role', 'start/10000/10000'); //TEST
                    }
                }, 1000);
            }
            else if (response.split('/')[0] == 'stopTime') {
                clearInterval(casinoRoleStartTime);
                document.querySelector('.casino-window-body-page-role-start-time').style.visibility = 'hidden';
            }
            else if (response.split('/')[0] == 'start') {
                casinoIsGame = true;
                uCefJS.triggerEvent('casino:removeMoney', casinoLastBet);
                uCefJS.triggerEvent('casino:startRole', 1);
                console.log('casino:removeMoney', casinoLastBet)
                setTimeout(() => {
                    document.querySelector('.casino-window-body-page-role-ball-bg-sectors').style = 'transform: rotate(0deg);';
                    document.querySelector('.casino-window-body-page-role-ball-block').style = 'transform: rotate(-0deg);';
                    document.querySelector('.casino-window-body-page-role-ball-container').style.display = '';
                    setTimeout(() => {
                        document.querySelector('.casino-window-body-page-role-ball-container').style.opacity = '1';
                    }, 500);

                    setTimeout(() => {
                        document.querySelector('.casino-window-body-page-role-ball-bg-sectors').style = 'transform: rotate('+response.split('/')[1]+'deg);';
                        document.querySelector('.casino-window-body-page-role-ball-block').style = 'transform: rotate(-'+response.split('/')[2]+'deg);';
                        cefSoundPlay('casinoRole.wav');

                        setTimeout(() => {
                            degBG = document.querySelector('.casino-window-body-page-role-ball-bg-sectors').style.transform.replace('rotate(', '').replace('deg)', '');
                            degBall = document.querySelector('.casino-window-body-page-role-ball-block').style.transform.replace('rotate(', '').replace('deg)', '');
                            
                            degBG2 = degBG-(360*Math.floor(degBG/360));
                            degBall2 = Math.abs(degBall)-(360*Math.floor(Math.abs(degBall/360)));
                            casinoRoleResult = 1;
    
                            if (degBG2+degBall2 < 360) {
                                casinoRoleResult = Math.round(Math.abs(degBG2+degBall2)/casinoRoleOneSector);
                            }
                            else if (degBG2+degBall2 > 360) {
                                casinoRoleResult = Math.round(Math.abs(degBG2+degBall2-360)/casinoRoleOneSector);
                            }
                            else if (degBG2+degBall2 == 360) {
                                casinoRoleResult = 0;
                            }

                            document.querySelector('.casino-window-body-page-role-ball-container').style.opacity = '0';
                            setTimeout(() => {
                                document.querySelector('.casino-window-body-page-role-ball-container').style.display = 'none';
                                casinoShowDialog('role-result', casinoRoleSectors[casinoRoleResult])
                                uCefJS.triggerEvent('casino:RoleResult', casinoRoleSectors[casinoRoleResult]);
                            }, 1000);
                            
                        }, 12000);
                    }, 2000);
                }, 1000);
            }
            else if (response.split('/')[0] == 'stopBet') {
                document.querySelectorAll('[casinoroleplayer]').forEach(element => {
                    if (element.querySelector('.casino-window-body-role-bottom-player-nickname').textContent == response.split('/')[1]) {
                        element.querySelector('.casino-window-body-role-bottom-player-bottom').style.visibility = 'hidden';
                    }
                });
            }
            break;
        case 'poker':
            if (response.split('/')[0] == 'join') {
                document.querySelector('.casino-window-body-page-poker-player[pokerplayer="'+response.split("/")[2]+'"] .casino-window-body-page-poker-player-nickname span').textContent = response.split('/')[1];

                pokerCountPlayers = 0;
                document.querySelectorAll('.casino-window-body-page-poker-player').forEach(element => {
                    if (element.querySelector('.casino-window-body-page-poker-player-nickname span').textContent) {
                        pokerCountPlayers++;
                    }
                });
                if (pokerCountPlayers > 1) {
                    if (document.querySelector('.casino-window-body-page-poker-bottom-game-start-button.disable')) {
                        document.querySelector('.casino-window-body-page-poker-bottom-game-start-button.disable').classList.remove('disable');
                    }
                }
            }
            else if (response.split('/')[0] == 'exit') {
                if (!casinoIsGame) {
                    document.querySelectorAll('.casino-window-body-page-poker-player').forEach(element => {
                        if (element.querySelector('.casino-window-body-page-poker-player-nickname span').textContent == response.split("/")[1]) {
                            element.querySelector('.casino-window-body-page-poker-player-nickname span').textContent = '';
                            if (element.querySelector('.casino-window-body-page-poker-player-nickname .poker-diler')) {
                                element.querySelector('.casino-window-body-page-poker-player-nickname .poker-diler').remove();
                            }
                        }
                    });
                }
                else {
                    casinoPokerExitList.push(response.split("/")[1]);
                    casinoResponse('poker', 'bet/'+response.split('/')[1]+'pass');
                }
            }
            else if (response.split('/')[0] == 'startTime') {
                document.querySelector('.casino-window-body-page-poker-start-time span').textContent = '15';
                document.querySelector('.casino-window-body-page-poker-start-time').style.visibility = 'visible';
                document.querySelector('.casino-window-body-page-poker-bottom-game-start-button').classList.add('disable');
                pokerStartTimeInterval = setInterval(() => {
                    document.querySelector('.casino-window-body-page-poker-start-time span').textContent = Number(document.querySelector('.casino-window-body-page-poker-start-time span').textContent)-1;

                    if (Number(document.querySelector('.casino-window-body-page-poker-start-time span').textContent) < 1) {
                        clearInterval(pokerStartTimeInterval);
                        document.querySelector('.casino-window-body-page-poker-start-time').style.visibility = 'hidden';
                        if (casinoPokerIsStarter) {
                            uCefJS.triggerEvent('Start:Poker', 2, casinoPokerTypeTableLast);
                            casinoPokerIsStarter = false;
                        }
                    }
                }, 1000);
            }
            else if (response.split('/')[0] == 'stopTime') {
                clearInterval(pokerStartTimeInterval);
                document.querySelector('.casino-window-body-page-poker-start-time').style.visibility = 'hidden';
            }
            else if (response.split('/')[0] == 'start') {
                clearInterval(pokerStartTimeInterval);
                casinoIsGame = true;
