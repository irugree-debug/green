            document.querySelectorAll('.casino-window-body-role-bottom-player').forEach(element => {
                element.querySelector('.casino-window-body-role-bottom-player-nickname').textContent = 'Nick_Name';
                element.querySelector('.casino-window-body-role-bottom-player-nickname').style.visibility = 'hidden';
                element.querySelector('.casino-window-body-role-bottom-player-bottom').style.visibility = 'hidden';
            });
            document.querySelector('[casinoroleplayer="1"] .casino-window-body-role-bottom-player-nickname').textContent = nickname;
            document.querySelector('[casinoroleplayer="1"] .casino-window-body-role-bottom-player-nickname').style.visibility = 'visible';
            document.querySelector('.casino-window-body-money-block').style.display = '';
            document.querySelector('.casino-window-body-money-block-poker').style.display = 'none';

            casinoRoleLastBet = '';
            casinoRoleLastPolys = [];
            casinoLastBet = 0;
            casinoRoleResult = 0;
            casinoRoleIsBet = false;
            casinoIsGame = false;
            break;
        case 'poker':
            casinoHideDialog('role-result');
            document.querySelector('.casino-window-header-title span').textContent = 'Покер';
            document.querySelector('.casino-window-header-title img').setAttribute('onclick', "casinoShowDialog('rules', 'Покер - инструкция', 'poker-rules')");
            document.querySelector('.casino-window-body-money-text-poker span').textContent = '0';
            casinoPokerReload();
            document.querySelectorAll('.casino-window-body-page-poker-player').forEach(element => {
                element.querySelector('.casino-window-body-page-poker-player-nickname span').textContent = '';
            });
            document.querySelector('.casino-window-body-money-block').style.display = 'none';
            document.querySelector('.casino-window-body-money-block-poker').style.display = '';
            casinoPokerTypeTableLast = table;
            break;
    }

    document.querySelector('.casino-window-body-page#'+type).style.display = '';
    document.querySelector('.casino').style.display = '';
}

