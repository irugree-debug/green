function casinoCheckCombination(cardsFull) {
    casinoCombination = '';
    cards = [];
    cardsFull.forEach(card => {
        cards.push([card[0], Number(card.replace(card[0], '').replace('J', 11).replace('Q', 12).replace('K', 13).replace('A', 14))]);
    });

    // Проверка флеш-рояль, стрит-флеш
    casinoFlesh = [];
    cards.forEach(card => {
        casinoFlesh.push(card[0]);
    });
    casinoFleshCount = casinoCountDuplicates(casinoFlesh)
    for (const key in casinoFleshCount) {
        if (casinoFleshCount[key] >= 5) {
            casinoStrit = [];
            cards.forEach(card => {
                if (card[0] == key) {
                    casinoStrit.push(card[1]);
                }
            });
            if (casinoStrit.includes(10) && casinoStrit.includes(11) && casinoStrit.includes(12) && casinoStrit.includes(13) && casinoStrit.includes(14)) {
                return 'fleshRoyal';
            }
            else if (casinoHasConsecutiveNumbers(casinoStrit)) {
                return 'stritFlesh';
            }
        }
    }

    // Проверка каре
    casinoKare = [];
    cards.forEach(card => {
        casinoKare.push(card[1]);
    });
    if (casinoHasDuplicates(casinoKare, 4)) {
        return 'kare';
    }

    // Проверка фулл хаус
    casinoFullHouse = [];
    cards.forEach(card => {
        casinoFullHouse.push(card[1]);
    });
    casinoCheckPara = false;
    casinoCheckSet = false;
    casinoFullHouseCount = casinoCountDuplicates(casinoFullHouse);
    for (const key in casinoFullHouseCount) {
        if (casinoFullHouseCount[key] >= 3) {
            casinoCheckSet = true;
            delete casinoFullHouseCount[key];
        }
        if (casinoFullHouseCount[key] >= 2) {
            casinoCheckPara = true;
            delete casinoFullHouseCount[key];
        }
    }
    if (casinoCheckSet && casinoCheckPara) {
        return 'fullHouse';
    }

    // Проверка флеш
    casinoFlesh = [];
    cards.forEach(card => {
        casinoFlesh.push(card[0]);
    });
    if (casinoHasDuplicates(casinoFlesh, 5)) {
        return 'flesh';
    }

    // Проверка стрит
    casinoStrit = [];
    cards.forEach(card => {
        casinoStrit.push(card[1]);
    });
    if (casinoHasConsecutiveNumbers(casinoStrit)) {
        return 'strit';
    }

    // Проверка сет
    casinoSet = [];
    cards.forEach(card => {
        casinoSet.push(card[1]);
    });
    if (casinoHasDuplicates(casinoSet, 3)) {
        return 'set';
    }

    // Проверка пар
    casinoPara = [];
    cards.forEach(card => {
        casinoPara.push(card[1]);
    });
    casinoCheckPara1 = false;
    casinoCheckPara2 = false;
    casinoParaCount = casinoCountDuplicates(casinoPara);
    for (const key in casinoParaCount) {
        if (casinoParaCount[key] >= 2) {
            if (!casinoCheckPara1) {
                casinoCheckPara1 = true;
            }
            else if (casinoCheckPara1) {
                casinoCheckPara2 = true;
            }
            delete casinoParaCount[key];
        }
    }
    if (casinoCheckPara1 && casinoCheckPara2) {
        return '2para';
    }
    else if (casinoCheckPara1) {
        return 'para';
    }

    return 'starhaya';
}

function casinoCountDuplicates(arr) {
    const counts = {};
    arr.forEach(str => {
        counts[str] = (counts[str] || 0) + 1;
    });

    return counts;
}

function casinoHasConsecutiveNumbers(arr) {
    const sortedArr = arr.slice().sort((a, b) => a - b);
    for (let i = 0; i <= sortedArr.length - 5; i++) {
        let count = 1;
        for (let j = i; j < sortedArr.length - 1; j++) {
            if (sortedArr[j + 1] - sortedArr[j] === 1) {
                count++;
                if (count === 5) {
                    return true;
                }
            } else {
                count = 1;
            }
        }
    }
    return false;
}

function casinoHasDuplicates(arr, countCheck) {
    const count = {};
    arr.forEach(item => {
        count[item] = (count[item] || 0) + 1;
    });
    for (let key in count) {
        if (count[key] >= countCheck) {
            return true;
        }
    }

    return false;
}

