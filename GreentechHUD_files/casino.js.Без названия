function casinoShowDialog(type, title, button1, button2) {
    if (document.querySelector('.casino-window-dialog').style.display == '') {
        casinoHideDialog();
        setTimeout(() => {
            casinoShowDialog(type, title, button1, button2);
        }, 300);
    }
    switch (type) {
        case 'askToPlay':
            document.querySelector('.casino-window-dialog#askToPlay .casino-window-dialog-block-title').innerHTML = 'Игра - кости (<span>15</span>с)';
            document.querySelector('.casino-window-dialog#askToPlay #casinoDiceATPNickname').textContent = title;
            document.querySelector('.casino-window-dialog#askToPlay #casinoDiceATPSum').textContent = moneyFormat(button1)+' ₽';

            casinoATPInterval = setInterval(() => {
                if (document.querySelector('.casino-window-dialog#askToPlay .casino-window-dialog-block-title span').textContent == '1') {
                    uCefJS.triggerEvent('casino:Response', 'dice', 'noResponseBet');
                    uCefJS.triggerEvent('casino:Response', 'dice', 'exit');
                    clearInterval(casinoATPInterval);
                    casinoHideDialog();
                    hideCasino();
                    showNotice(4, 'Казино', 'Вы не ответили на ставку и были исключены из игры.');
                }
                document.querySelector('.casino-window-dialog#askToPlay .casino-window-dialog-block-title span').textContent = Number(document.querySelector('.casino-window-dialog#askToPlay .casino-window-dialog-block-title span').textContent)-1;
            }, 1000);
            break;
        case 'info':
            document.querySelector('.casino-window-dialog-block-info-title').innerHTML = title;
            document.querySelector('.casino-window-dialog#info .casino-window-dialog-block-button.active').textContent = button1;
            document.querySelector('.casino-window-dialog#info .casino-window-dialog-block-button.active').style.display = '';
            break;
        case 'infoWait':
            document.querySelector('.casino-window-dialog-block-info-title').innerHTML = title;
            document.querySelector('.casino-window-dialog#info .casino-window-dialog-block-button.active').style.display = 'none';
            type = 'info';
            casinoBetInterval = setInterval(() => {
                if (document.querySelector('.casino-window-dialog-block-info-title span').textContent == '1') {
                    clearInterval(casinoBetInterval);
                    casinoHideDialog();

                    //TEST
                    // casinoResponse('dice', 'noResponseBet');
                    // casinoResponse('dice', 'exit');
                }
                document.querySelector('.casino-window-dialog-block-info-title span').textContent = Number(document.querySelector('.casino-window-dialog-block-info-title span').textContent)-1;
            }, 1000);
            break;
        case 'switch':
            document.querySelector('.casino-window-dialog-block-info-title').innerHTML = title;
            document.querySelector('.casino-window-dialog#switch .casino-window-dialog-block-button').textContent = button1;
            document.querySelector('.casino-window-dialog#switch .casino-window-dialog-block-button').setAttribute('onclick', 'casinoHideDialog()');
            document.querySelector('.casino-window-dialog#switch .casino-window-dialog-block-button.active').textContent = button2;
            document.querySelector('.casino-window-dialog#switch .casino-window-dialog-block-button.active').setAttribute('onclick', 'uCefJS.triggerEvent("Casino:Close", 1); casinoHideDialog();');
            break;
        case 'rules':
            document.querySelector('.casino-window-dialog-block-rules-title span').innerHTML = title;
            document.querySelectorAll('.casino-window-dialog-block-rules-textarea').forEach(element => {
                element.style.display = 'none';
            });
            document.querySelector('.casino-window-dialog-block-rules-textarea#'+button1).style.display = '';
            break;
        case 'poker-cards':
            document.querySelector('.casino-window-dialog-block-rules-textarea#poker-cards').style.display = '';
            break
        case 'role-result':
            document.querySelector('.casino-window-dialog-block-role-result').classList.remove('red');
            document.querySelector('.casino-window-dialog-block-role-result').classList.remove('black');
            if (casinoRolePoly['red'].includes(title)) {
                document.querySelector('.casino-window-dialog-block-role-result').classList.add('red');
            }
            else if (casinoRolePoly['black'].includes(title)) {
                document.querySelector('.casino-window-dialog-block-role-result').classList.add('black');
            }
            document.querySelector('.casino-window-dialog-block-role-result').textContent = title;

            resultPrice = 0;

            console.log(casinoRoleLastBet, title)

            if (casinoRoleLastBet == '1-18' && title >= 1 && title <= 18) {
                resultPrice = casinoLastBet*2;
            }
            else if (casinoRoleLastBet == '19-36' && title >= 19 && title <= 36) {
                resultPrice = casinoLastBet*2;
            }
            else if (casinoRoleLastBet == 'red' && casinoRolePoly['red'].includes(title)) {
                resultPrice = casinoLastBet*2;
            }
            else if (casinoRoleLastBet == 'black' && casinoRolePoly['black'].includes(title)) {
                resultPrice = casinoLastBet*2;
            }
            else if (casinoRoleLastBet == 'chet' && title % 2 == 0) {
                resultPrice = casinoLastBet*2;
            }
            else if (casinoRoleLastBet == 'nechet' && title % 2 != 0) {
                resultPrice = casinoLastBet*2;
            }
            else if (casinoRoleLastBet == '1st12' && title >= 1 && title <= 12) {
                resultPrice = casinoLastBet*3;
            }
            else if (casinoRoleLastBet == '2nd12' && title >= 13 && title <= 24) {
                resultPrice = casinoLastBet*3;
            }
            else if (casinoRoleLastBet == '3rd12' && title >= 25 & title <= 36) {
                resultPrice = casinoLastBet*3;
            }
            else if (casinoRoleLastBet == '1col' && casinoRolePoly['1col'].includes(title)) {
                resultPrice = casinoLastBet*3;
            }
            else if (casinoRoleLastBet == '2col' && casinoRolePoly['2col'].includes(title)) {
                resultPrice = casinoLastBet*3;
            }
            else if (casinoRoleLastBet == '3col' && casinoRolePoly['3col'].includes(title)) {
                resultPrice = casinoLastBet*3;
            }
            else if (Number(casinoRoleLastBet) >= 1 && Number(casinoRoleLastBet) <= 36 && title == Number(casinoRoleLastBet)) {
                resultPrice = casinoLastBet*7;
            }
            else if ((title == '0' && casinoRoleLastBet == '0') || (title == '00' && casinoRoleLastBet == '00')) {
                resultPrice = casinoLastBet*7;
            }
            else {
                resultPrice = 0;
            }

            if (resultPrice != 0) {
                showNotice(1, 'Вы выиграли!', 'Ваша ставка: '+casinoRoleLastBet+', выигрыш: '+resultPrice+'.');
                console.log('casino:giveMoney',resultPrice)
                uCefJS.triggerEvent('casino:giveMoney', casinoNickname, resultPrice*0.9);
            }
            else {
                showNotice(3, 'Вы проиграли', 'Ваша ставка: '+casinoRoleLastBet+', выпало: '+title+'.');
            }

            casinoRoleResultTime = 5;
            casinoRoleResultTimer = setInterval(() => {
                casinoRoleResultTime--;
                if (casinoRoleResultTime < 0) {
                    casinoHideDialog('role-result');
                    clearInterval(casinoRoleResultTimer);
                }
            }, 1000);
            break;
    }

    document.querySelector('.casino-window-dialog#'+type).style.display = '';
    setTimeout(() => {
        document.querySelector('.casino-window-dialog#'+type).style.opacity = '1';
    }, 100);

}

function casinoHideDialog(type) {
    if (type == 'role-result') {
        uCefJS.triggerEvent('casino:Response', 'role', 'stopBet/'+casinoNickname);
        uCefJS.triggerEvent('casino:startRole', 0);
        casinoResponse('role', 'stopBet/'+casinoNickname);

        casinoRoleLastBet = '';
        casinoRoleLastPolys = [];
        casinoLastBet = 0;
        casinoRoleResult = 0;
        casinoRoleIsBet = false;
        casinoIsGame = false;
    }

    document.querySelectorAll('.casino-window-dialog').forEach(element => {
        if (element.style.display != 'none') {
            element.style.opacity = '0';
            setTimeout(() => {
                element.style.display = 'none';
            }, 300);
        }
    });
}