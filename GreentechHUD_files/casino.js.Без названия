window.addEventListener('mouseover', function (event) {
    document.querySelectorAll('.casino-window-body-page-role-table-svg [casinorole]').forEach(element => {
        if (element.getAttribute('stroke') != '#FFE603') {
            element.setAttribute('stroke', 'white');
        }
    });

    casinoRoleLastPolys.forEach(element => {
        if (!casinoRoleIsBet) {
            document.querySelector('.casino-window-body-page-role-table-svg [casinorole="'+element+'"]').setAttribute('stroke', '#FFE603');
        }
    });

	if (event.target.getAttribute('casinorolebutton') && !casinoRoleIsBet) {
        if (document.querySelector('.casino-window-body-page-role-table-svg [casinorole="'+event.target.getAttribute('casinorolebutton')+'"]').getAttribute('stroke') == '#FFE603') {
            return;
        }

        document.querySelector('.casino-window-body-page-role-table-svg [casinorole="'+event.target.getAttribute('casinorolebutton')+'"]').setAttribute('stroke', '#03FF3B');

        if (casinoRolePoly[event.target.getAttribute('casinorolebutton')]) {
            casinoRolePoly[event.target.getAttribute('casinorolebutton')].forEach(element => {
                document.querySelector('.casino-window-body-page-role-table-svg [casinorole="'+element+'"]').setAttribute('stroke', '#03FF3B');
            });
        }
        else if (event.target.getAttribute('casinorolebutton') == '1st12') {
            for (i = 1; i <= 12; i++) {
                document.querySelector('.casino-window-body-page-role-table-svg [casinorole="'+i+'"]').setAttribute('stroke', '#03FF3B');
            }
        }
        else if (event.target.getAttribute('casinorolebutton') == '2nd12') {
            for (i = 13; i <= 24; i++) {
                document.querySelector('.casino-window-body-page-role-table-svg [casinorole="'+i+'"]').setAttribute('stroke', '#03FF3B');
            }
        }
        else if (event.target.getAttribute('casinorolebutton') == '3rd12') {
            for (i = 25; i <= 36; i++) {
                document.querySelector('.casino-window-body-page-role-table-svg [casinorole="'+i+'"]').setAttribute('stroke', '#03FF3B');
            }
        }
        else if (event.target.getAttribute('casinorolebutton') == '1-18') {
            for (i = 1; i <= 18; i++) {
                document.querySelector('.casino-window-body-page-role-table-svg [casinorole="'+i+'"]').setAttribute('stroke', '#03FF3B');
            }
        }
        else if (event.target.getAttribute('casinorolebutton') == '19-36') {
            for (i = 19; i <= 36; i++) {
                document.querySelector('.casino-window-body-page-role-table-svg [casinorole="'+i+'"]').setAttribute('stroke', '#03FF3B');
            }
        }
        else if (event.target.getAttribute('casinorolebutton') == 'chet') {
            document.querySelectorAll('.casino-window-body-page-role-table-svg [casinorole]').forEach(element => {
                if (Number(element.getAttribute('casinorole')) % 2 == 0 && Number(element.getAttribute('casinorole')) >= 1 && Number(element.getAttribute('casinorole')) <= 36) {
                    element.setAttribute('stroke', '#03FF3B');
                }
            });
        }
        else if (event.target.getAttribute('casinorolebutton') == 'nechet') {
            document.querySelectorAll('.casino-window-body-page-role-table-svg [casinorole]').forEach(element => {
                if (Number(element.getAttribute('casinorole')) % 2 != 0 && Number(element.getAttribute('casinorole')) >= 1 && Number(element.getAttribute('casinorole')) <= 36) {
                    element.setAttribute('stroke', '#03FF3B');
                }
            });
        }
    }
})

window.addEventListener('click', function (event) {
	if (event.target.getAttribute('casinorolebutton') && !casinoRoleIsBet) {
        document.querySelectorAll('.casino-window-body-page-role-table-svg [stroke="#FFE603"]').forEach(element => {
            element.setAttribute('stroke', 'white');
        });
        casinoRoleLastBet = event.target.getAttribute('casinoRoleButton');
        casinoRoleLastPolys = [];
        document.querySelector('.casino-window-body-page-role-table-svg [casinorole="'+event.target.getAttribute('casinorolebutton')+'"]').setAttribute('stroke', '#FFE603');
        if (Number(document.querySelector('.casino-window-body-page-role-table-svg [casinorole="'+event.target.getAttribute('casinorolebutton')+'"]').getAttribute('casinorole')) >= 1 && Number(document.querySelector('.casino-window-body-page-role-table-svg [casinorole="'+event.target.getAttribute('casinorolebutton')+'"]').getAttribute('casinorole')) <= 35) {
            casinoRoleLastPolys.push(document.querySelector('.casino-window-body-page-role-table-svg [casinorole="'+event.target.getAttribute('casinorolebutton')+'"]').getAttribute('casinorole'));
        }
        document.querySelectorAll('.casino-window-body-page-role-table-svg [stroke="#03FF3B"]').forEach(element => {
            element.setAttribute('stroke', '#FFE603');
            if (Number(element.getAttribute('casinorole')) >= 1 && Number(element.getAttribute('casinorole')) <= 36) {
                casinoRoleLastPolys.push(element.getAttribute('casinorole'));
            }
        });
        
        if (casinoRoleLastPolys.length == 0) {
            casinoRoleLastPolys = [event.target.getAttribute('casinoRoleButton')];
        }
    }
})

function showCasino(type, nickname, table) {
    document.querySelectorAll('.casino-window-body-page').forEach(element => {
        element.style.display = 'none';
    });

    casinoNickname = nickname;
    casinoLastBet = 0;
    casinoIsGame = false;
    casinoPokerShowAll = false;

    switch (type) {
        case 'dice': 
            document.querySelector('.casino-window-header-title span').textContent = 'Кости';
            document.querySelector('.casino-window-header-title img').setAttribute('onclick', "casinoShowDialog('rules', 'Кости - инструкция', 'dice-rules')");
            document.querySelector('.casino-window-body-dice-poly.own .casino-window-body-dice-poly-nickname').textContent = nickname;
            document.querySelector('.casino-window-body-dice-poly.vs .casino-window-body-dice-poly-nickname').textContent = '';
            document.querySelectorAll('.casino-window-body-dice-poly-dice').forEach(element => {
                element.style.display = 'none';
            });
            document.querySelectorAll('.casino-window-body-dice-poly-dice-pips').forEach(element => {
                element.style.display = 'none';
            });
            document.querySelectorAll('.casino-window-body-dice-poly-score').forEach(element => {
                element.style.display = 'none';
            });
            document.querySelector('.casino-window-body-money-block').style.display = '';
            document.querySelector('.casino-window-body-money-block-poker').style.display = 'none';
            break;
        case 'role':
            document.querySelector('.casino-window-header-title span').textContent = 'Рулетка';
            document.querySelector('.casino-window-header-title img').setAttribute('onclick', "casinoShowDialog('rules', 'Рулетка - инструкция', 'role-rules')");
            setTimeout(() => {
                document.querySelector('.casino-window-body-page-role-table-buttons').style.width = document.querySelector('.casino-window-body-page-role-table-svg').getBoundingClientRect().width+'px';
                document.querySelector('.casino-window-body-page-role-table-buttons').style.height = document.querySelector('.casino-window-body-page-role-table-svg').getBoundingClientRect().height+'px';
